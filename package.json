{
  "name": "sciconnect",
  "version": "1.0.0",
  "description": "A social platform for scientists, tech enthusiasts, and hobbyists",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "build": "cd frontend && npm install && npm run build",
    "dev:full": "concurrently \"npm run dev\" \"cd frontend && npm run dev\"",
    "install:all": "npm install && cd frontend && npm install",
    "setup": "node setup.js",
    "migrate": "node scripts/migrate-to-postgres.js",
    "migrate:dry-run": "echo 'Migration dry run - checking connections...' && node -e \"require('./scripts/migrate-to-postgres.js')\"",
    "check-data": "node scripts/check-existing-data.js"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "crypto-random-string": "^5.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "react-image-crop": "^11.0.10",
    "redis": "^5.6.0",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^5.1.7",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
